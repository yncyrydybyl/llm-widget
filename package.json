{
  "name": "llm-widget",
  "version": "0.1.1",
  "description": "A Matrix widget that runs an LLM in the browser and answers !ai requests in the room",
  "scripts": {
    "dev": "pnpm vendor && vite",
    "dev:https": "pnpm vendor && HTTPS=1 vite",
    "build": "pnpm vendor && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "vendor": "node scripts/vendor.mjs"
  },
  "author": "Yan Minagawa",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/yncyrydybyl/llm-widget.git"
  },
  "homepage": "https://github.com/yncyrydybyl/llm-widget#readme",
  "bugs": "https://github.com/yncyrydybyl/llm-widget/issues",
  "packageManager": "pnpm@10.29.3",
  "dependencies": {
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@huggingface/transformers": "^4.3.1",
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "@mlc-ai/web-llm": "^0.2.86",
    "@tesseract.js-data/deu": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "matrix-widget-api": "^1.20.0",
    "pdfjs-dist": "^6.4.299",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@webgpu/types": "^0.1.74",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
